# --- Base de données (PostgreSQL 16 + pgvector) ---
POSTGRES_USER=efelia
POSTGRES_PASSWORD=efelia_dev_change_moi
POSTGRES_DB=efelia
DATABASE_URL=postgresql+psycopg://efelia:efelia_dev_change_moi@db:5432/efelia
# Base utilisée par les tests (créée automatiquement au premier démarrage de `db`)
TEST_DATABASE_URL=postgresql+psycopg://efelia:efelia_dev_change_moi@db:5432/efelia_test

# --- File de tâches ---
REDIS_URL=redis://redis:6379/0

# --- Fournisseur LLM ---
# auto : Cohere si COHERE_API_KEY est renseignée, sinon mode démo (FakeProvider)
# cohere | fake : forcer un fournisseur
LLM_PROVIDER=auto
COHERE_API_KEY=

# --- Fichiers déposés ---
STOCKAGE_DIR=/data/dossiers
MAX_TAILLE_MO=20
MAX_PAGES=60

# --- RGPD ---
# Durée de conservation des dossiers avant purge automatique
RETENTION_JOURS=180

# --- Limitation de débit (par adresse IP) ---
LIMITE_DEPOTS_PAR_HEURE=10
LIMITE_ELIGIBILITE_PAR_MINUTE=30

# --- Divers ---
LOG_LEVEL=INFO
CORS_ORIGINES=http://localhost:3000,http://localhost:5173
REGLES_FICHIER=/config/regles_2026.yaml
REGLEMENT_TEXTE=/config/reglement_2026.md
